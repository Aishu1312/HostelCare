# This project reads Firebase credentials via Streamlit secrets
# (.streamlit/secrets.toml), not environment variables — see
# .streamlit/secrets.toml.example for the format actually used.
#
# This file is kept only as a convenience placeholder in case you adapt
# the FirebaseService/config layer to read from the environment instead
# (e.g. for a non-Streamlit deployment target).

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
